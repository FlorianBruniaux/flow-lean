{
  "claude": {
    "command": [
      "claude",
      "--disable-slash-commands",
      "--print",
      "--output-format",
      "json",
      "--no-session-persistence",
      "--setting-sources",
      "",
      "--strict-mcp-config",
      "--tools",
      "",
      "--system-prompt",
      "You are a helpful assistant.",
      "--model",
      "claude-sonnet-5"
    ],
    "cwd": "empty",
    "response_format": "claude-json",
    "budget_flag": "--max-budget-usd"
  },
  "claude-native": {
    "command": [
      "claude",
      "--disable-slash-commands",
      "--print",
      "--output-format",
      "json",
      "--no-session-persistence",
      "--setting-sources",
      "",
      "--strict-mcp-config",
      "--model",
      "claude-sonnet-5",
      "--disallowedTools",
      "Bash,Write,Edit,NotebookEdit,WebFetch"
    ],
    "cwd": "repo",
    "response_format": "claude-json",
    "budget_flag": "--max-budget-usd"
  }
}
